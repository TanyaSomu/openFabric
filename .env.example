# Application Port
PORT=8080

# Environment: development, test, production
NODE_ENV=development

# SQLite Database Path
DATABASE_PATH=./database/permissions.db

# Auth0 OAuth2 / JWT Configuration
# The base URL of your Auth0 tenant (must end with /)
AUTH0_ISSUER_URL=https://dev-example.us.auth0.com/
# The API Identifier (Audience) configured in Auth0
AUTH0_AUDIENCE=https://api.openfabric.example.com

# Logging Level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
