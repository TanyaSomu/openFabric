{
  "name": "openfabric-auth-service",
  "version": "1.0.0",
  "description": "Authentication and Authorization Service with OAuth2 JWT verification and hierarchical SQLite permissions",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:init": "tsx src/scripts/init-db.ts"
  },
  "keywords": [
    "authentication",
    "authorization",
    "oauth2",
    "jwt",
    "auth0",
    "sqlite",
    "rbac"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
